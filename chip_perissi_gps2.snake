rule plotMatrix_GPS2signal:
    input:
        diff_isr = 'Differentiation/GPS2/results/bigwig/GPS2overATF4ISR_centered_defaultwindow_matrix.gz',
        diff_tt = 'Differentiation/GPS2/results/bigwig/GPS2overATF4WT_centered_defaultwindow_matrix.gz',
        treat_gps2onISR = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4ISR_withATF4ISRbwnormalized_centered_defaultwindow_matrix.gz',
        treat_gps2onWT = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4_WT_withATF4WTbwnormalized_centered_defaultwindow_matrix.gz'
    output:
        diff_isr = 'Differentiation/GPS2/results/GPS2overATF4ISR_centered_defaultwindow_plotprofile.png',
        diff_tt = 'Differentiation/GPS2/results/GPS2overATF4WT_centered_defaultwindow_plotprofile.png',
        treat_gps2onISR = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4ISR_withATF4ISRbwnormalized_centered_defaultwindow_plotprofile.png',
        treat_gps2onWT = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4_WT_withATF4WTbwnormalized_centered_defaultwindow_plotprofile.png'

    conda:
        'envs/deeptools_env.yml'
    shell:
        '''
        plotProfile -m {input.diff_isr} -o {output.diff_isr} --perGroup --plotTitle "GPS2 ChIP-seq Signal Around ATF4_ISR Peaks during Differentiation"
        plotProfile -m {input.diff_tt} -o {output.diff_tt} --perGroup --plotTitle "GPS2 ChIP-seq Signal Around ATF4_WT Peaks during Differentiation"
        plotProfile -m {input.treat_gps2onISR} -o {output.treat_gps2onISR} --perGroup --plotTitle "GPS2 normalized ChIP-seq Signal Around ATF4_ISR Peaks during Treatment"
        plotProfile -m {input.treat_gps2onWT} -o {output.treat_gps2onWT} --perGroup --plotTitle "GPS2 normalized ChIP-seq Signal Around ATF4_WT Peaks during Treatment"
        '''
