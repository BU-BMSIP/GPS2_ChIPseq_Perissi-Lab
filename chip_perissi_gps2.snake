        treat_gps2onWT = 'WT/GPS2/results/bigwig/RNA_seq/GPS2overATF4_WT_mTORC1peaks_defaultwindow_matrix.gz'
    output:
        treat_gps2onISR = 'WT/GPS2/results/bigwig/RNA_seq/GPS2overATF4ISR_mTORC1_plotprofile.png',
        treat_gps2onWT = 'WT/GPS2/results/bigwig/RNA-seq/GPS2overATF4WT_mTORC1_plotprofile.png'

    conda:
        'envs/deeptools_env.yml'
    shell:
        '''
        plotProfile -m {input.treat_gps2onISR} -o {output.treat_gps2onISR} --perGroup --plotTitle "WT - GPS2 ChIP-seq Signal Around ATF4_ISR over mTORC1"
        plotProfile -m {input.treat_gps2onWT} -o {output.treat_gps2onWT} --perGroup --plotTitle "WT - GPS2 ChIP-seq Signal Around ATF4_WT over mTORC1"
        '''

