rule computeMatrix_Treatment_GPS2signal_overATF4_ISR_RNAseq:
    input:
        gps2_no_1 = 'Treatment/GPS2/results/bigwig/normalized/gps2_noFCCP_rep1.bw',
        gps2_no_2 = 'Treatment/GPS2/results/bigwig/normalized/gps2_noFCCP_rep2.bw',
        gps2_with_1 = 'Treatment/GPS2/results/bigwig/normalized/gps2_withFCCP_rep1.bw',
        gps2_with_2 = 'Treatment/GPS2/results/bigwig/normalized/gps2_withFCCP_rep2.bw',
        ATF4_ISR_bw = 'Treatment/ATF4/results/bigwig/normalized/ATF4_ISR.bw',
        ATF4_WTvsKO = 'Treatment/ATF4/results/annotation/ATF4_ISRpeaks_from_WTvsKO_RNAseq.bed',
        ATF4_WTvsKO_TT = 'Treatment/ATF4/results/annotation/ATF4_ISRpeaks_from_WTvsKO-TT_RNAseq.bed',
        ATF4_WTvsWT_TT = 'Treatment/ATF4/results/annotation/ATF4_ISRpeaks_from_WTvsWT-TT_RNAseq.bed',
        ATF4_WT_TTvsKO = 'Treatment/ATF4/results/annotation/ATF4_ISRpeaks_from_WT-TTvsKO_RNAseq.bed',
        ATF4_WT_TTvsKO_TT = 'Treatment/ATF4/results/annotation/ATF4_ISRpeaks_from_WT-TTvsKO-TT_RNAseq.bed',
        ATF4_KOvsKO_TT = 'Treatment/ATF4/results/annotation/ATF4_ISRpeaks_from_KOvsKO-TT_RNAseq.bed'
    output:
        'Treatment/GPS2/results/bigwig/RNA_seq/GPS2overATF4_ISR_vs_ATF_RNA_defaultwindow_matrix.gz'
    conda:
        'envs/deeptools_env.yml'
    threads: 16
