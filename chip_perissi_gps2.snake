rule plotHeatmap_GPS2signal:
    input:
        treat_gps2onISR = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4ISR_withATF4ISRbwnormalized_centered_defaultwindow_matrix.gz',
        treat_gps2onWT = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4_WT_withATF4WTbwnormalized_centered_defaultwindow_matrix.gz'
    output:
        treat_gps2onISR = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4ISR_withATF4ISRbwnormalized_centered_defaultwindow_plotheatmap.png',
        treat_gps2onWT = 'Treatment/GPS2/results/bigwig/normalized/GPS2overATF4_WT_withATF4WTbwnormalized_centered_defaultwindow_plotheatmap.png'

    conda:
        'envs/deeptools_env.yml'
    shell:
        '''
        plotHeatmap -m {input.treat_gps2onISR} -o {output.treat_gps2onISR} --perGroup --plotTitle "GPS2 normalized ChIP-seq Signal Around ATF4_ISR Peaks during Treatment"
        plotHeatmap -m {input.treat_gps2onWT} -o {output.treat_gps2onWT} --perGroup --plotTitle "GPS2 normalized ChIP-seq Signal Around ATF4_WT Peaks during Treatment"
        '''

rule intersect:
    input:
        atf4_isr = 'Treatment/ATF4/results/filtered/ATF4_ISR_bf.narrowPeak',
        atf4_wt = 'Treatment/ATF4/results/filtered/ATF4_WT_bf.narrowPeak',
        gps2_fccp = 'Treatment/GPS2/results/filtered/gps2_withFCCP_bf.narrowPeak'
    output:
        atf4_wt = 'Treatment/GPS2overlap_on_ATF4_WT.narrowPeak',
        atf4_isr = 'Treatment/GPS2overlap_on_ATF4_ISR.narrowPeak',        
        overlap_isr_and_wt = 'Treatment/ATF4_ISR_on_ATF4_WT.narrowPeak'
    conda:
        'envs/bedtools_env.yml'
    shell:
        '''
        bedtools intersect -bed -a {input.gps2_fccp} -b {input.atf4_isr} > {output.atf4_isr}
        bedtools intersect -bed -a {input.gps2_fccp} -b {input.atf4_wt} > {output.atf4_wt}
        bedtools intersect -bed -a {input.atf4_wt} -b {input.atf4_isr} > {output.overlap_isr_and_wt}
        '''

rule overlaps:
    input:
        atf4_isr = 'Treatment/ATF4/results/filtered/ATF4_ISR_bf.narrowPeak',
        atf4_wt = 'Treatment/ATF4/results/filtered/ATF4_WT_bf.narrowPeak',
        gps2_fccp = 'Treatment/GPS2/results/filtered/gps2_withFCCP_bf.narrowPeak',
        gps2_day0 = 'Differentiation/GPS2/results/filtered/gps2_day0_bf.narrowPeak',
        gps2_day6 = 'Differentiation/GPS2/results/filtered/gps2_day6_bf.narrowPeak',
        gps2_nofccp = 'Treatment/GPS2/results/macs3/gps2_withFCCP_rep1_NC_peaks.narrowPeak',
        blacklist = 'samples/mm39.excluderanges.bed'
    output:
        gps2_fccp_overlap_WT = 'Treatment/GPS2_FCCPoverlap_on_ATF4_WT',
        gps2_fccp_overlap_ISR = 'Treatment/GPS2_FCCPoverlap_on_ATF4_ISR',
        gps2_day0_overlap_WT = 'Differentiation/GPS2_day0_overlap_on_ATF4_WT',
        gps2_day0_overlap_ISR = 'Differentiation/GPS2_day0_overlap_on_ATF4_ISR',
        gps2_day6_overlap_WT = 'Differentiation/GPS2_day6_overlap_on_ATF4_WT',
        gps2_day6_overlap_ISR = 'Differentiation/GPS2_day6_overlap_on_ATF4_ISR',
        gps2_nofccp_overlap_gps2day0 = 'Treatment/GPS2_noFCCP_overlap_on_GPS2_day0.bed',
        gps2_day0_overlap_day6 = 'Differentiation/GPS2_day0_overlap_on_GPS2_day6',
        gps2_nofccp = 'Treatment/GPS2/results/filtered/gps2_withFCCP_rep1_NC_bf_peaks.narrowPeak'

    conda:
        'envs/bedtools_env.yml'
    shell:
        '''
        bedtools intersect -v -a {input.gps2_nofccp} -b {input.blacklist} > {output.gps2_nofccp}
        bedtools intersect -a {input.gps2_fccp} -b {input.atf4_isr} > {output.gps2_fccp_overlap_ISR}
        bedtools intersect -a {input.gps2_fccp} -b {input.atf4_wt} > {output.gps2_fccp_overlap_WT}
        bedtools intersect -a {input.gps2_day0} -b {input.atf4_isr} > {output.gps2_day0_overlap_ISR}
        bedtools intersect -a {input.gps2_day0} -b {input.atf4_wt} > {output.gps2_day0_overlap_WT}
        bedtools intersect -a {input.gps2_day6} -b {input.atf4_isr} > {output.gps2_day6_overlap_ISR}
        bedtools intersect -a {input.gps2_day6} -b {input.atf4_wt} > {output.gps2_day6_overlap_WT}
        bedtools intersect -a {output.gps2_nofccp} -b {input.gps2_day0} > {output.gps2_nofccp_overlap_gps2day0}
        bedtools intersect -a {input.gps2_day0} -b {input.gps2_day6} > {output.gps2_day0_overlap_day6}
        '''

