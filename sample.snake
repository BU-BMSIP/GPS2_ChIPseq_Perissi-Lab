import pandas as pd

# Read the CSV file and extract the list of filenames
sample_csv = pd.read_csv('Sample_Data.csv')
sample_csv['full_name'] = sample_csv['Target Directory'] + '/samples/' + sample_csv['File name']
sample_csv.set_index('full_name', inplace=True)
NAMES = set(sample_csv['File name'].tolist())
FULL_NAMES = sample_csv.index.tolist()
DIR = set(sample_csv['Target Directory'].tolist())
EXTENSIONS = [1, 2, 3, 4, 'rev.1', 'rev.2']
REP = ['rep1', 'rep2']
REPEATS = ['rep1', 'rep2', 'rep3']

# Define the Snakemake rules
rule all:
    input:
        expand('{full_name}.fastq.gz', full_name=FULL_NAMES),
        expand('{dir}/results/fastqc/{file}_fastqc.html', 
               zip, dir=sample_csv['Target Directory'], file=sample_csv['File name']),
        expand('{dir}/results/trimmed/{file}_trim.fastq.gz', 
               zip, dir=sample_csv['Target Directory'], file=sample_csv['File name']),
        'Differentiation/GPS2/results/macs/gps2_day0_peaks.narrowPeak',
        'Differentiation/GPS2/results/sorted/gps2_day6_peaks.narrowPeak',
        'Differentiation/ATF4/results/sorted/ATF_noDMI_peaks.narrowPeak',
        'FCCP_Treatment/GPS2/results/macs3/gps2_withFCCP_peaks.narrowPeak',
        'FCCP_Treatment/ATF4/results/macs3/ATF4_WT_peaks.narrowPeak',
        'WT/GPS2/results/macs3/chip_sictl_peaks.narrowPeak',
        'WT/GPS2/results/macs3/chip_sigps2_peaks.narrowPeak'
        
rule wget_files:
    output:
        '{full_name}.raw.fastq.gz'
    params:
        link = lambda wildcards: sample_csv.loc[wildcards.full_name, 'FTP Link']
    threads: 8
    run:
        import os
        directory = os.path.dirname(output[0])
        os.makedirs(directory, exist_ok=True)
        shell('wget -O {output} {params.link}')

rule fastqc:
    input: 
        '{dir}/samples/{file}.fastq.gz'
    output:
        html = '{dir}/results/fastqc/{file}_fastqc.html',
        zip = '{dir}/results/fastqc/{file}_fastqc.zip'
    params:
        outdir = lambda wildcards, output: os.path.dirname(output.html)
    threads: 8
    conda:
        'envs/fastqc_env.yml'
    shell:
        '''
        mkdir -p {params.outdir}
        fastqc {input} -o {params.outdir}
        '''

rule trimomatic:
    input:
        fastq = '{dir}/samples/{file}.fastq.gz'
    output:
        trimmed = '{dir}/results/trimmed/{file}_trim.fastq.gz'
    params:
        ad = 'samples/TruSeq3-SE.fa',
        outdir = lambda wildcards, output: os.path.dirname(output.trimmed)
    threads: 8
    conda:
        'envs/trimmomatic_env.yml'
    shell:
        '''
        wget -O {params.ad} https://github.com/usadellab/Trimmomatic/raw/main/adapters/TruSeq3-SE.fa
        trimmomatic SE -threads {threads} {input.fastq} {output.trimmed} ILLUMINACLIP:{params.ad}:2:30:10 LEADING:3 TRAILING:3 SLIDINGWINDOW:4:15 MINLEN:36
        '''

rule callpeak_diff:
    input:
        day0 = 'Differentiation/GPS2/results/sorted/gps2_day0.sorted.bam',
        day6 = 'Differentiation/GPS2/results/sorted/gps2_day6.sorted.bam',
        noDMI = 'Differentiation/ATF4/results/sorted/ATF_noDMI.sorted.bam',
    output:
        day0 = 'Differentiation/GPS2/results/macs3/gps2_day0_peaks.narrowPeak',
        day6 = 'Differentiation/GPS2/results/macs3/gps2_day6_peaks.narrowPeak',
        noDMI = 'Differentiation/ATF4/results/macs3/ATF_noDMI_peaks.narrowPeak',
    params:
        day0 = lambda wildcards, output: os.path.dirname(output.day0),
        day6 = lambda wildcards, output: os.path.dirname(output.day6),
        noDMI = lambda wildcards, output: os.path.dirname(output.noDMI),
    conda:
        'envs/macs3_env.yml'
    threads: 16
    shell:
        '''
        macs3 callpeak -t {input.day0} -f BAM -g 2654621783 -n gps2_day0 --nolambda -B -q 0.05 --outdir {params.day0}
        macs3 callpeak -t {input.day6} -f BAM -g 2654621783 -n gps2_day6 --nolambda -B -q 0.05 --outdir {params.day6}
        macs3 callpeak -t {input.noDMI} -f BAM -g 2654621783 -n ATF_noDMI --nolambda -B -q 0.05 --outdir {params.noDMI}
        '''

rule callpeak_WT:
    input:
        siCTL = 'WT/GPS2/results/sorted/chip_sictl.sorted.bam',
        siGPS2 = 'WT/GPS2/results/sorted/chip_sigps2.sorted.bam'
    output:
        siCTL = 'WT/GPS2/results/macs3/chip_sictl_peaks.narrowPeak',
        siGPS2 = 'WT/GPS2/results/macs3/chip_sigps2_peaks.narrowPeak'
    params:
        macs = lambda wildcards, output: os.path.dirname(output.siCTL)
    threads: 16
    conda:
        'envs/macs3_env.yml'
    shell:
        '''
        macs3 callpeak -t {input.siCTL} -f BAM -g 2654621783 -n chip_sictl --nolambda -B -q 0.05 --outdir {params.macs3}
        macs3 callpeak -t {input.siGPS2} -f BAM -g 2654621783 -n chip_sigps2 --nolambda -B -q 0.05 --outdir {params.macs3}
        '''

rule callpeak_FCCP:
    input:
        GPS2with = expand('FCCP_Treatment/GPS2/results/sorted/gps2_withFCCP_{rep}.sorted.bam', rep=REP),
        GPS2ko = expand('FCCP_Treatment/GPS2/results/sorted/gps2_withFCCP_{rep}.sorted.bam', rep=REP),
        ATF4with = expand('FCCP_Treatment/ATF4/results/sorted/ATF4_WT_{rep}.sorted.bam', rep=REPEATS),
        ATF4ko = expand('FCCP_Treatment/ATF4/results/sorted/ATF4_KO_{rep}.sorted.bam', rep=REPEATS)
    output:
        GPS2 = 'FCCP_Treatment/GPS2/results/macs3/gps2_withFCCP_peaks.narrowPeak',
        ATF4 = ''FCCP_Treatment/ATF4/results/macs3/ATF4_WT_peaks.narrowPeak'
    params:
        GPS2 = lambda wildcards, output: os.path.dirname(output.GPS2),
        ATF4 = lambda wildcards, output: os.path.dirname(output.ATF4)
    threads: 16
    conda:
        'envs/macs3_env.yml'
    shell:
        '''
        macs3 callpeak -t {input.GPS2with} -c {input.GPS2ko} -f BAM -g 2654621783 -n gps2_withFCCP -B -q 0.05 --outdir {params.GPS2}
        macs3 callpeak -t {input.ATF4with} -c {input.ATF4ko} -f BAM -g 2654621783 -n ATF4_WT -B -q 0.05 --outdir {params.ATF4}
        '''

rule filter_blacklist:
	input:
		intersect = 'results/RUNX1_intersect.bed',
		blacklist = 'results/hg38-blacklist.v2.bed'
	output:
		'results/RUNX1_bf.bed'
	conda:
		'envs/bedtools_env.yml'
	shell:
		'''
		bedtools intersect -v -a {input.intersect} -b {input.blacklist} > {output}
		'''

rule unzip_gtf:
	input:
		'results/gencode.v45.primary_assembly.annotation.gtf.gz'
	output:
		'results/gencode.v45.primary_assembly.annotation.gtf'
	shell:
		'''
		gunzip {input}
		'''

rule annotate_peaks:
	input:
		bf = 'results/RUNX1_bf.bed',
		gtf = 'results/gencode.v45.primary_assembly.annotation.gtf'
	output:
		'results/RUNX1_annotated.txt'
	conda:
		'envs/homer_env.yml'
	shell:
		'''
		annotatePeaks.pl {input.bf} hg38 -gtf {input.gtf}  > {output}
		'''

rule unzip_genome:
	input:
		'results/GRCh38.primary_assembly.genome.fa.gz'
	output:
		'results/GRCh38.primary_assembly.genome.fa'
	shell:
		'''
		gunzip {input}
		'''

rule motifs:
	input:
		bf = 'results/RUNX1_bf.bed',
		fasta = 'results/GRCh38.primary_assembly.genome.fa'
	output:
		directory('results/RUNX1_motifs/')
	conda:
		'envs/homer_env.yml'
	shell:
		'''
		findMotifsGenome.pl {input.bf} {input.fasta} {output} -size 200
		'''

rule computeMatrix:
	input:
		bigwig = 'results/RUNX1_{rep}.bw',
		bed = 'results/hg38_genes_all.bed'
	output:
		'results/RUNX1_{rep}_matrix.gz'
	params:
		window = 2000
	conda:
		'envs/deeptools_env.yml'
	threads: 4
	shell:
		'''
		computeMatrix scale-regions -S {input.bigwig} -R {input.bed} -a {params.window} -b {params.window} --outFileName {output}
		'''

rule plotMatrix:
	input:
		'results/RUNX1_{rep}_matrix.gz'
	output:
		'results/RUNX1_{rep}_Plotprofile.png'
	conda:
		'envs/deeptools_env.yml'
	shell:
		'''
		plotProfile -m {input} -o {output}
		'''

rule concatenate_fastq:
    input:
        ATF4_WT = expand('FCCP_Treatment/samples/ATF4_WT_{rep}.fastq.gz', rep = REPEATS),
        ATF4_KO = expand('FCCP_Treatment/samples/ATF4_KO_{rep}.fastq.gz', rep = REPEATS)
    output:
        ATF4_WT = 'FCCP_Treatment/samples/ATF4_WT.fastq.gz'
        ATF4_KO = 'FCCP_Treatment/samples/ATF4_KO.fastq.gz'
    shell:
        '''
        cat {input.ATF4_WT} > {output.ATF4_WT}
        cat {input.ATF4_KO} > {output.ATF4_KO}
        '''
